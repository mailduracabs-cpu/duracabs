APP_NAME="Dura Cabs"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=duracabs
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Shared public-site cache
SITE_SETTINGS_CACHE_TTL=60

# Cookie consent
COOKIE_CONSENT_NAME=duracabs_cookie_consent
COOKIE_CONSENT_VERSION=1
COOKIE_CONSENT_DAYS=365
COOKIE_CONSENT_SECURE=false
COOKIE_CONSENT_STORAGE_KEY=duracabs_cookie_consent
COOKIE_CONSENT_PATH=/
COOKIE_CONSENT_DOMAIN=
COOKIE_CONSENT_SAME_SITE=Lax
